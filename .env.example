# Copy to .env and fill in. Load with `set -a; . ./.env; set +a` or use direnv.
# NEVER commit your real .env.

# The Odds API (https://the-odds-api.com)
#   - needed when pinnacle_source=the_odds_api (Pinnacle line, UK-friendly)
#   - or when provider=the_odds_api in multi_book mode
ODDS_API_KEY=

# Betfair Exchange (https://developer.betfair.com)
#   - the betting venue: needed for live price fetch (venue_source=betfair)
#     and live placement (executor=betfair + live=true)
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_APP_KEY=
# Path to your Betfair client certs (.crt/.key) for non-interactive login.
# Leave blank to use interactive login.
BETFAIR_CERTS_PATH=

# Pinnacle direct API (https://api.pinnacle.com) - ONLY for pinnacle_source=direct.
# NOTE: Pinnacle left the UK market; UK customers generally cannot get an account.
# UK users should use pinnacle_source=the_odds_api instead.
PINNACLE_USERNAME=
PINNACLE_PASSWORD=

# Extra hard safety switch. Real bets require BOTH live:true in config
# AND (optionally) this set. Leave unset/false while testing.
BETTING_LIVE=false
