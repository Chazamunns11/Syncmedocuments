# Tendari environment variables — copy to .env.local and fill in.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Base URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar sync ---
# Server-only Supabase key (Settings -> API -> service_role). Used to store
# calendar tokens securely. NEVER expose to the browser / NEVER prefix NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# Google Cloud OAuth client (Web application). Redirect URI must be
# <NEXT_PUBLIC_SITE_URL>/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Added in later phases ---
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# ANTHROPIC_API_KEY=
